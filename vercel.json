{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/work", "destination": "/api/file?slot=work" },
    { "source": "/info", "destination": "/api/file?slot=info" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/upload", "destination": "/api/upload" }
  ]
}
